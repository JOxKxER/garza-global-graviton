{
  "output_dir": "dataset_revisions",
  "revision": "",
  "max_concurrency": 4,
  "requests_per_second": 1.0,
  "timeout_seconds": 30.0,
  "max_retries": 4,
  "backoff_base_seconds": 1.0,
  "user_agents": [
    "PublicDataPipeline/1.0 (+https://your-domain.example/contact)",
    "Mozilla/5.0 (compatible; PublicDataPipeline/1.0)"
  ],
  "sources": [
    {
      "name": "replace-with-public-source",
      "url": "https://example.org/public-records",
      "record_selector": "article.record",
      "fields": [
        {"name": "title", "selector": "h2", "required": true},
        {"name": "summary", "selector": ".summary"},
        {"name": "observed_at", "selector": "time", "required": true},
        {"name": "target_url", "selector": "a.details", "attribute": "href"}
      ]
    }
  ]
}
