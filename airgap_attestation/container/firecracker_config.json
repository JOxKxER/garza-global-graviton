{
  "boot-source": {
    "kernel_image_path": "/var/lib/airgap-vm/vmlinux-airgap-hardened",
    "boot_args": "console=ttyS0 reboot=k panic=1 pci=off ro init=/sbin/init.airgap"
  },
  "drives": [
    {
      "drive_id": "rootfs",
      "path_on_host": "/var/lib/airgap-vm/rootfs-airgap-runner.ext4",
      "is_root_device": true,
      "is_read_only": true
    },
    {
      "drive_id": "job_input",
      "path_on_host": "/var/lib/airgap-vm/job_input.ext4",
      "is_root_device": false,
      "is_read_only": true
    },
    {
      "drive_id": "job_output",
      "path_on_host": "/var/lib/airgap-vm/job_output.ext4",
      "is_root_device": false,
      "is_read_only": false
    }
  ],
  "network-interfaces": [],
  "machine-config": {
    "vcpu_count": 2,
    "mem_size_mib": 2048,
    "smt": false,
    "track_dirty_pages": false
  }
}
