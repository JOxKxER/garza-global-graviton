# Copy to .env and fill in real values. Never commit the real .env file.
# The app defaults to paper mode and refuses live trading unless BOTH
# TRADING_MODE=live and ALLOW_LIVE_TRADING=true are set (see config.py).

ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

TRADING_MODE=paper
ALLOW_LIVE_TRADING=false

TRADING_SYMBOLS=AAPL,MSFT,SPY

RISK_PER_TRADE_PCT=0.01
KELLY_FRACTION=0.5
STOP_LOSS_PCT=0.02
TAKE_PROFIT_PCT=0.04
MAX_DAILY_DRAWDOWN_PCT=0.03
MIN_SIGNAL_PROBABILITY=0.58

TRADING_CACHE_DIR=trading_app_cache
